{
  "name": "@tencent-connect/dsh-qqbot",
  "version": "0.5.2",
  "description": "QQ Bot IM channel plugin for deepseek-harness (dsh)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "scripts": {
    "build": "tsc && tsdown --config tsdown.client.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/",
    "test": "vitest run",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "clean": "rm -rf dist lib",
    "ci:prepare-test-pkg": "node scripts/prepare-test-pkg.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "qqbot",
    "cordis",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tencent-connect/dsh-qqbot.git"
  },
  "homepage": "https://github.com/tencent-connect/dsh-qqbot#readme",
  "bugs": {
    "url": "https://github.com/tencent-connect/dsh-qqbot/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.0-rc.8": "compatible",
        "0.2.0-rc.2": "compatible"
      },
      "note": "0.1.0-rc.8 为 CLI（dsh web）已验证：扫码/手动/解绑全流程、终端二维码与端内绑定页；0.2.0-rc.2 为 Desktop 内嵌运行时已验证：端内绑定页（settings.section 与侧栏）、HMR 重载收敛。客户端依赖 settings.section / sidebarRightTabs / sidebar.right.pane.tab 席位契约与 dsh.client 模块系统，宿主大版本升级后请重新验收席位行为。"
    }
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.5",
    "js-yaml": "^4.1.0",
    "qrcode": "^1.5.4",
    "yaml": "2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.18.1",
    "@tencent-connect/qqbot-connector": "1.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": false
    },
    "@deepseek-ai/dsh-agent": {
      "optional": false
    },
    "@deepseek-ai/dsh-session": {
      "optional": false
    },
    "@deepseek-ai/dsh-llm": {
      "optional": false
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}
